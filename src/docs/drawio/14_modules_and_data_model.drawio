 y="540"/><mxPoint x="1620" y="1160"/></Array></mxGeometry></mxCell><mxCell id="p2_title" value="Data model  —  15 tables, crow’s-foot cardinality from the actual FOREIGN KEY constraints" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="2080" height="36" as="geometry"/></mxCell><mxCell id="p2_leg" value="&lt;b&gt;1 : N&lt;/b&gt; = FK column is NOT NULL  •  &lt;b&gt;0..1 : N&lt;/b&gt; = FK column is NULL-able  •  &lt;b&gt;1 : 1&lt;/b&gt; = FK column is UNIQUE  •  colour = owning module (blue Customer, orange RFQ, purple Campaign, green Inventory, grey shared identity)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="1380" width="2080" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
