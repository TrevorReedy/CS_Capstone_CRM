# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# The previous version of this file shipped a working password. Placeholders
# only from here on; that password must be rotated on the server, since it is
# still recoverable from the git history.

APP_NAME="Typhon Cath CRM"
APP_ENV=local
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=typhon_cath_crm
DB_USER=replace-me
DB_PASS=replace-me

# Session hardening — consumed by app/Core/bootstrap.php.
SESSION_NAME=typhon_cath_crm_session
# Force the Secure cookie flag even when APP_ENV is not production.
SESSION_SECURE=false
# Seconds of inactivity before the session is dropped.
SESSION_IDLE_TIMEOUT=1800
# Seconds since login before re-authentication is required regardless of activity.
SESSION_ABSOLUTE_TIMEOUT=28800
