10" y="52" width="150" height="56" as="geometry"/></mxCell><mxCell id="core_note" value="Every &lt;b&gt;Repository&lt;/b&gt; obtains its handle from &lt;b&gt;Database::connection()&lt;/b&gt;. Every &lt;b&gt;Controller&lt;/b&gt; passes through &lt;b&gt;Permissions&lt;/b&gt; + &lt;b&gt;Csrf&lt;/b&gt; before it dispatches." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#444444;" vertex="1" parent="core"><mxGeometry x="20" y="118" width="1340" height="28" as="geometry"/></mxCell><mxCell id="p1_title" value="Module architecture  —  Controller → Service → Repository, per module" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1380" height="40" as="geometry"/></mxCell><mxCell id="p1_leg" value="Solid arrow = calls, within a module.   &lt;font color='#9673a6'&gt;&lt;b&gt;Dashed purple&lt;/b&gt;&lt;/font&gt; = cross-module read.   Method lists are representative; the italic line gives the count not shown." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1456" width="1380" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 - Data Model &amp; Cardinality"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_rp" value="role_permissions" style="swimlane;html=1;startSize=34;fontSize=15;fontStyle=1;align=center;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="400" height="88" as="geometry"/></mxCell><mxCell id="t_rp_r0" value="&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt;  role_id" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fon